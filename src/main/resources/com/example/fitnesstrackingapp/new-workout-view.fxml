<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0"
            prefWidth="1050.0"
            stylesheets="@styles.css"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.fitnesstrackingapp.controller.NewWorkoutController">

    <top>
        <VBox spacing="5.0"
              styleClass="header-panel">

            <padding>
                <Insets bottom="15.0"
                        left="20.0"
                        right="20.0"
                        top="20.0"/>
            </padding>

            <Label text="Novi trening"
                   styleClass="page-title"/>

            <Label text="Evidentiranje održanog treninga"
                   styleClass="page-subtitle"/>
        </VBox>
    </top>

    <center>
        <VBox maxWidth="650.0"
              spacing="20.0"
              styleClass="form-panel">

            <padding>
                <Insets bottom="30.0"
                        left="30.0"
                        right="30.0"
                        top="30.0"/>
            </padding>

            <Label text="Podaci o treningu"
                   styleClass="section-title"/>

            <GridPane hgap="15.0"
                      vgap="18.0">

                <Label text="Plan:"
                       styleClass="form-label"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <ComboBox fx:id="planComboBox"
                          prefWidth="350.0"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="0"/>

                <Label text="Datum:"
                       styleClass="form-label"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <DatePicker fx:id="workoutDatePicker"
                            prefWidth="350.0"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="1"/>

                <Label text="Trajanje:"
                       styleClass="form-label"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"/>

                <TextField fx:id="durationField"
                           prefWidth="350.0"
                           promptText="Trajanje treninga u minutima"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"/>

                <Label text="Napomena:"
                       styleClass="form-label"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3"/>

                <TextArea fx:id="notesArea"
                          prefHeight="160.0"
                          prefWidth="350.0"
                          promptText="Dodatne napomene o treningu"
                          wrapText="true"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="3"/>
            </GridPane>

            <HBox spacing="12.0">
                <Button text="Sačuvaj trening"
                        styleClass="primary-button"
                        onAction="#handleCreateSession"/>

                <Button text="Očisti"
                        styleClass="secondary-button"
                        onAction="#clearForm"/>
            </HBox>

            <Label fx:id="statusLabel"
                   text="Pokrenite server pre evidentiranja treninga."
                   wrapText="true"/>
        </VBox>

        <BorderPane.margin>
            <Insets bottom="30.0"
                    left="40.0"
                    right="40.0"
                    top="30.0"/>
        </BorderPane.margin>
    </center>

</BorderPane>