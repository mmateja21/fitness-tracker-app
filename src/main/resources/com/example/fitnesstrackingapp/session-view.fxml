<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0"
            prefWidth="1050.0"
            stylesheets="@styles.css"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.fitnesstrackingapp.controller.WorkoutSessionController">

    <top>
        <VBox spacing="5.0"
              styleClass="header-panel">

            <padding>
                <Insets bottom="15.0"
                        left="20.0"
                        right="20.0"
                        top="20.0"/>
            </padding>

            <Label text="Istorija treninga"
                   styleClass="page-title"/>

            <Label text="Pregled svih evidentiranih treninga"
                   styleClass="page-subtitle"/>
        </VBox>
    </top>

    <center>
        <TableView fx:id="sessionTable">

            <columns>
                <TableColumn fx:id="idColumn"
                             prefWidth="60.0"
                             text="ID"/>

                <TableColumn fx:id="dateColumn"
                             prefWidth="140.0"
                             text="Datum"/>

                <TableColumn fx:id="planColumn"
                             prefWidth="140.0"
                             text="Plan"/>

                <TableColumn fx:id="durationColumn"
                             prefWidth="150.0"
                             text="Trajanje (min)"/>

                <TableColumn fx:id="notesColumn"
                             prefWidth="420.0"
                             text="Napomena"/>
            </columns>

            <BorderPane.margin>
                <Insets bottom="15.0"
                        left="20.0"
                        right="20.0"
                        top="15.0"/>
            </BorderPane.margin>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="10.0">
            <HBox spacing="30.0">
                <Label fx:id="totalWorkoutsLabel"
                       text="Broj treninga: 0"
                       style="-fx-text-fill: #0b2e59; -fx-font-weight: bold; -fx-font-size: 14px;"/>

                <Label fx:id="totalDurationLabel"
                       text="Ukupno trajanje: 0 min"
                       style="-fx-text-fill: #0b2e59; -fx-font-weight: bold; -fx-font-size: 14px;"/>

                <Label fx:id="averageDurationLabel"
                       text="Prosečno trajanje: 0.0 min"
                       style="-fx-text-fill: #0b2e59; -fx-font-weight: bold; -fx-font-size: 14px;"/>
            </HBox>

            <HBox spacing="10.0">
                <Button text="Osveži"
                        styleClass="secondary-button"
                        onAction="#loadSessions"/>

                <Button text="Odrađene vežbe"
                        styleClass="primary-button"
                        onAction="#handleManageExercises"/>

                <Button text="Obriši trening"
                        styleClass="danger-button"
                        onAction="#handleDelete"/>
            </HBox>

            <Label fx:id="statusLabel"
                   text="Pokrenite server pre učitavanja podataka."/>

            <BorderPane.margin>
                <Insets bottom="15.0"
                        left="20.0"
                        right="20.0"
                        top="5.0"/>
            </BorderPane.margin>
        </VBox>
    </bottom>

</BorderPane>