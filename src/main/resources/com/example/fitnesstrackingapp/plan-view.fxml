<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0"
            prefWidth="1050.0"
            stylesheets="@styles.css"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.fitnesstrackingapp.controller.WorkoutPlanController">

    <top>
        <VBox spacing="5.0"
              styleClass="header-panel">
            <padding>
                <Insets bottom="15.0"
                        left="20.0"
                        right="20.0"
                        top="20.0"/>
            </padding>

            <Label text="Planovi treninga"
                   styleClass="page-title"/>

            <Label text="Kreiranje i upravljanje planovima"
                   styleClass="page-subtitle"/>
        </VBox>
    </top>

    <center>
        <TableView fx:id="planTable">
            <columns>
                <TableColumn fx:id="idColumn"
                             prefWidth="60.0"
                             text="ID"/>

                <TableColumn fx:id="nameColumn"
                             prefWidth="220.0"
                             text="Naziv"/>

                <TableColumn fx:id="descriptionColumn"
                             prefWidth="330.0"
                             text="Opis"/>

                <TableColumn fx:id="createdAtColumn"
                             prefWidth="170.0"
                             text="Kreiran"/>
            </columns>

            <BorderPane.margin>
                <Insets bottom="20.0"
                        left="20.0"
                        right="15.0"
                        top="15.0"/>
            </BorderPane.margin>
        </TableView>
    </center>

    <right>
        <VBox prefWidth="320.0"
              spacing="15.0"
              styleClass="form-panel">

            <padding>
                <Insets bottom="20.0"
                        left="15.0"
                        right="20.0"
                        top="15.0"/>
            </padding>

            <Label text="Podaci o planu"
                   styleClass="section-title"/>

            <GridPane hgap="10.0" vgap="12.0">
                <Label text="Naziv:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="nameField"
                           promptText="Npr. Push trening"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

                <Label text="Opis:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <TextArea fx:id="descriptionArea"
                          prefHeight="160.0"
                          promptText="Opis plana treninga"
                          wrapText="true"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="1"/>
            </GridPane>

            <HBox spacing="10.0">
                <Button text="Dodaj"
                        styleClass="primary-button"
                        onAction="#handleCreate"/>

                <Button text="Izmeni"
                        styleClass="secondary-button"
                        onAction="#handleUpdate"/>
            </HBox>

            <HBox spacing="10.0">
                <Button text="Obriši"
                        styleClass="danger-button"
                        onAction="#handleDelete"/>

                <Button text="Očisti"
                        styleClass="secondary-button"
                        onAction="#handleClear"/>
            </HBox>
            <Button maxWidth="Infinity"
                    text="Uredi vežbe u planu"
                    styleClass="primary-button"
                    onAction="#handleManageExercises"/>
        </VBox>
    </right>

    <bottom>
        <Label fx:id="statusLabel"
               text="Pokrenite server pre učitavanja podataka.">

            <BorderPane.margin>
                <Insets bottom="15.0"
                        left="20.0"
                        right="20.0"
                        top="5.0"/>
            </BorderPane.margin>
        </Label>
    </bottom>
</BorderPane>