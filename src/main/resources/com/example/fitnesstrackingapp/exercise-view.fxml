<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0"
            prefWidth="1050.0"
            stylesheets="@styles.css"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.fitnesstrackingapp.controller.ExerciseController">


    <top>
        <VBox spacing="5.0" styleClass="header-panel">
            <padding>
                <Insets bottom="15.0"
                        left="20.0"
                        right="20.0"
                        top="20.0"/>
            </padding>

            <Label text="Upravljanje vežbama"
            styleClass="page-title"/>
            <Label text="Dodavanje, pregled, izmena i brisanje vežbi"
            styleClass="page-subtitle"/>
        </VBox>
    </top>

    <center>
        <TableView fx:id="exerciseTable">
            <columns>
                <TableColumn fx:id="idColumn"
                             prefWidth="60.0"
                             text="ID"/>

                <TableColumn fx:id="nameColumn"
                             prefWidth="170.0"
                             text="Naziv"/>

                <TableColumn fx:id="muscleGroupColumn"
                             prefWidth="130.0"
                             text="Mišićna grupa"/>

                <TableColumn fx:id="equipmentColumn"
                             prefWidth="180.0"
                             text="Oprema"/>

                <TableColumn fx:id="descriptionColumn"
                             prefWidth="260.0"
                             text="Opis"/>
            </columns>

            <BorderPane.margin>
                <Insets bottom="20.0"
                        left="20.0"
                        right="15.0"
                        top="5.0"/>
            </BorderPane.margin>
        </TableView>
    </center>

    <right>
        <VBox prefWidth="320.0" spacing="15.0" styleClass="form-panel">
            <padding>
                <Insets bottom="20.0"
                        left="15.0"
                        right="20.0"
                        top="5.0"/>
            </padding>

            <Label text="Podaci o vežbi"
            styleClass="section-title"/>

            <GridPane hgap="10.0" vgap="12.0">
                <Label text="Naziv:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="nameField"
                           promptText="Npr. Bench Press"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

                <Label text="Grupa:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <ComboBox fx:id="muscleGroupComboBox"
                          promptText="Izaberi grupu"
                          prefWidth="190.0"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="1"/>

                <Label text="Oprema:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"/>

                <TextField fx:id="equipmentField"
                           promptText="Potrebna oprema"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"/>

                <Label text="Opis:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3"/>

                <TextArea fx:id="descriptionArea"
                          promptText="Opis izvođenja vežbe"
                          prefHeight="120.0"
                          wrapText="true"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="3"/>
            </GridPane>

            <HBox spacing="10.0">
                <Button text="Dodaj"
                        styleClass="primary-button"
                        onAction="#handleCreate"/>

                <Button text="Izmeni"
                        styleClass="secondary-button"
                        onAction="#handleUpdate"/>
            </HBox>

            <HBox spacing="10.0">
                <Button text="Obriši"
                        styleClass="danger-button"
                        onAction="#handleDelete"/>

                <Button text="Očisti"
                        styleClass="secondary-button"
                        onAction="#handleClear"/>
            </HBox>
        </VBox>
    </right>

    <bottom>
        <Label fx:id="statusLabel"
               text="Pokrenite server pre učitavanja podataka.">

            <BorderPane.margin>
                <Insets bottom="15.0"
                        left="20.0"
                        right="20.0"
                        top="5.0"/>
            </BorderPane.margin>
        </Label>
    </bottom>
</BorderPane>