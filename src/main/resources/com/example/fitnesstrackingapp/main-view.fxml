<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0"
            prefWidth="1280.0"
            stylesheets="@styles.css"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.fitnesstrackingapp.controller.MainController">

    <left>
        <VBox prefWidth="220.0"
              spacing="12.0"
              styleClass="sidebar">

            <padding>
                <Insets bottom="20.0"
                        left="18.0"
                        right="18.0"
                        top="25.0"/>
            </padding>

            <Label text="NEMA IME :("
                   styleClass="app-title"/>

            <Label text="Upravljanje treninzima"
                   styleClass="app-subtitle"/>

            <Separator/>

            <Button maxWidth="Infinity"
                    text="Vežbe"
                    styleClass="nav-button"
                    onAction="#showExercises"/>

            <Button maxWidth="Infinity"
                    text="Planovi treninga"
                    styleClass="nav-button"
                    onAction="#showPlans"/>

            <Button maxWidth="Infinity"
                    text="Novi trening"
                    styleClass="nav-button"
                    disable="true"/>

            <Button maxWidth="Infinity"
                    text="Istorija"
                    styleClass="nav-button"
                    disable="true"/>

            <Button maxWidth="Infinity"
                    text="Statistika"
                    styleClass="nav-button"
                    disable="true"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentPane"
                   styleClass="content-pane"/>
    </center>
</BorderPane>